# Riot developer or personal API key from https://developer.riotgames.com
RIOT_API_KEY=RGAPI-your-key-here
# Regional routing for account/match endpoints: americas, europe, asia, sea
RIOT_REGION=americas
# Postgres connection string (pgvector is needed from Milestone 2)
DATABASE_URL=postgresql://localhost/tftcoach
# LLM with tool calling, via an OpenAI-compatible Chat Completions endpoint.
# Default: Gemini free tier (key from https://aistudio.google.com, no card needed).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-llm-key-here
LLM_MODEL=gemini-3.8-flash
# Embedding model on the same endpoint, for patch-note retrieval
EMBEDDING_MODEL=gemini-embedding-2
# Alternative: Meta Model API (requires billing)
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3-contributor
